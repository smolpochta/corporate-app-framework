<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBEBEB">

    <!-- ЗОНА ШАПКИ (15%) - 2 варианта -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerZone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#EBEBEB"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHeight_percent="0.15">

        <!-- Вариант 1: пустой, играет заставка, грузятся данные -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerOption1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:background="#EBEBEB">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Вариант 2: шапка меню, иконка и текст пользователя, погода -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerOption2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#EBEBEB">

            <!-- Иконка -->
            <ImageView
                android:id="@+id/userIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_user_logo"
                android:alpha="0.6"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="16dp" />

            <!-- Иконка декатера (скрыта по умолчанию) -->
            <ImageView
                android:id="@+id/decanterIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_decanter_logo"
                android:alpha="0.0"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="16dp" />


            <!-- Текст справа от иконки -->
            <TextView
                android:id="@+id/userText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Dекантер"
                android:textColor="#4A4A4A"
                android:textSize="21sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toEndOf="@id/userIcon"
                app:layout_constraintEnd_toStartOf="@id/weatherContainer"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <!-- Контейнер погоды в правом углу -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/weatherContainer"
                android:layout_width="90dp"
                android:layout_height="72dp"
                android:padding="0dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="16dp">

                <!-- Температура - слева -->
                <TextView
                    android:id="@+id/weather_grad"
                    android:layout_width="45dp"
                    android:layout_height="55dp"
                    android:text="+3°"
                    android:textColor="#4A4A4A"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"
                    android:gravity="center|right"
                    android:shadowColor="#80FFFFFF"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Контейнер для иконок погоды -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/weatherIconsContainer"
                    android:layout_width="55dp"
                    android:layout_height="82dp"
                    android:padding="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/weather_grad"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Группа иконок - центрирована по вертикали -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/weatherIconsGroup"
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:padding="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Верхняя иконка погоды -->
                        <ImageView
                            android:id="@+id/weatherTop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:padding="0dp"
                            android:layout_margin="0dp"
                            android:cropToPadding="false"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Нижняя иконка погоды -->
                        <ImageView
                            android:id="@+id/weatherBottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:padding="0dp"
                            android:layout_margin="0dp"
                            android:cropToPadding="false"
                            app:layout_constraintTop_toBottomOf="@id/weatherTop"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Текст "нет данных" -->
                <TextView
                    android:id="@+id/weatherNoData"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:text="нет\nданных"
                    android:textColor="#4A4A4A"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:shadowColor="#80FFFFFF"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/weather_grad"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- АКТИВНАЯ ЗОНА (70%) - 5 вариантов -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activeZone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#EBEBEB"
        app:layout_constraintTop_toBottomOf="@id/headerZone"
        app:layout_constraintBottom_toTopOf="@id/menuZone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHeight_percent="0.70">

        <!-- Вариант 1: заставка или заглушка -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/activeOption1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:background="#EBEBEB"
            android:clipChildren="false">

            <!-- Верхняя guideline для начала элементов -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/topGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0" />

            <!-- Нижняя guideline для конца элементов -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/bottomGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.70" />

            <!-- Заставка -->
            <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#EBEBEB"
                android:visibility="visible"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintTop_toTopOf="@id/topGuide"
                app:layout_constraintBottom_toBottomOf="@id/bottomGuide"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="2.25"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <!-- Заглушка -->
            <ImageView
                android:id="@+id/animateImageView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:background="#EBEBEB"
                app:layout_constraintTop_toTopOf="@id/topGuide"
                app:layout_constraintBottom_toBottomOf="@id/bottomGuide"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.8"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Вариант 2: окно приветствия -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/activeOption2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#EBEBEB">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Вариант 3: список команд "Магазин" -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/activeOption3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#EBEBEB">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.9"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="5dp">

                    <!-- Сверка ценников -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/priceCheckItem"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/command_item_background"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/priceCheckIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:alpha="0.6"
                            android:src="@drawable/ic_price_check_24dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/priceCheckText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Сверка ценников"
                            android:textColor="#4A4A4A"
                            android:textSize="21sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="normal"
                            app:layout_constraintStart_toEndOf="@id/priceCheckIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:gravity="center_vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Вариант 4: список команд "Склад" -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/activeOption4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#EBEBEB">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.9"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="5dp">

                    <!-- Прием накладных -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/receiptItem"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/command_item_background"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/receiptIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_receipt_24dp"
                            android:alpha="0.6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/receiptText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Прием накладных"
                            android:textColor="#4A4A4A"
                            android:textSize="21sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="normal"
                            app:layout_constraintStart_toEndOf="@id/receiptIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:gravity="center_vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Вариант 5: список команд "Информация" -->
        <androidx.constraintlayout.widget.ConstraintLayout

            android:id="@+id/activeOption5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#EBEBEB">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.9"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="5dp">

                    <!-- Акции -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/salesItem"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/command_item_background"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/salesIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_sales_24dp"
                            android:alpha="0.6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/salesText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Акции"
                            android:textColor="#4A4A4A"
                            android:textSize="21sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="normal"
                            app:layout_constraintStart_toEndOf="@id/salesIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:gravity="center_vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Команда -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/teamItem"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@drawable/command_item_background"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/teamIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_team_24dp"
                            android:alpha="0.6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/teamText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Команда"
                            android:textColor="#4A4A4A"
                            android:textSize="21sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="normal"
                            app:layout_constraintStart_toEndOf="@id/teamIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:gravity="center_vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- О программе -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/aboutItem"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/command_item_background"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aboutIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_about_24dp"
                            android:alpha="0.6"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/aboutText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Справка"
                            android:textColor="#4A4A4A"
                            android:textSize="21sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="normal"
                            app:layout_constraintStart_toEndOf="@id/aboutIcon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:gravity="center_vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ЗОНА МЕНЮ (10%) - 2 варианта -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menuZone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#EBEBEB"
        app:layout_constraintBottom_toTopOf="@id/progressZone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHeight_percent="0.10">

        <!-- Вариант 1: сейчас пустой, после того кк убрал клиент ай-ди и версию программы -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/menuOption1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Вариант 2: основное меню -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/menuOption2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@android:color/transparent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/menuContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.8"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.8">

                <!-- Индикатор активного элемента -->
                <View
                    android:id="@+id/activeIndicator"
                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:background="@drawable/active_menu_indicator"
                    android:visibility="invisible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.333" />

                <!-- Пункт "магазин" -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/menuStore"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/menuWarehouse"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.333">

                    <ImageView
                        android:id="@+id/menuStoreIcon"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:src="@drawable/ic_store_24dp"
                        android:tint="#4A4A4A"
                        android:scaleType="fitCenter"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/menuStoreText"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.6"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.6" />

                    <TextView
                        android:id="@+id/menuStoreText"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="Магазин"
                        android:textColor="#4A4A4A"
                        android:textSize="12sp"
                        android:fontFamily="arial"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/menuStoreIcon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.8"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.3" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Пункт "склад" -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/menuWarehouse"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/menuStore"
                    app:layout_constraintEnd_toStartOf="@+id/menuInfo"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.333">

                    <ImageView
                        android:id="@+id/menuWarehouseIcon"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:src="@drawable/ic_warehouse_24dp"
                        android:tint="#4A4A4A"
                        android:scaleType="fitCenter"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/menuWarehouseText"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.6"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.6" />

                    <TextView
                        android:id="@+id/menuWarehouseText"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="Склад"
                        android:textColor="#4A4A4A"
                        android:textSize="12sp"
                        android:fontFamily="arial"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/menuWarehouseIcon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.8"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.3" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Пункт "информация" -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/menuInfo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/menuWarehouse"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_default="percent"
                    app:layout_constraintWidth_percent="0.333">

                    <ImageView
                        android:id="@+id/menuInfoIcon"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:src="@drawable/ic_info_24dp"
                        android:tint="#4A4A4A"
                        android:scaleType="fitCenter"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@+id/menuInfoText"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.6"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.6" />

                    <TextView
                        android:id="@+id/menuInfoText"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:text="Информация"
                        android:textColor="#4A4A4A"
                        android:textSize="12sp"
                        android:fontFamily="arial"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/menuInfoIcon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_default="percent"
                        app:layout_constraintWidth_percent="0.8"
                        app:layout_constraintHeight_default="percent"
                        app:layout_constraintHeight_percent="0.3" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ЗОНА ПРОГРЕСС-БАРА (5%) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progressZone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#EBEBEB"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHeight_percent="0.05">

        <!-- статус -->
        <TextView
            android:id="@+id/progressStatusTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#000000"
            android:textSize="13dp"
            android:fontFamily="arial"
            android:alpha="1"
            android:gravity="center"
            android:visibility="gone"
            android:background="@android:color/transparent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/progressBar"
            app:layout_constraintEnd_toEndOf="@id/progressBar"
            android:layout_marginBottom="2dp" />

        <!-- полоска -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#80FF4081"
            android:progressBackgroundTint="#80666666"
            android:alpha="1"
            android:elevation="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_percent="0.95" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Сообщения пользователю -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/messageContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintVertical_bias="0.5">

        <!-- сообщение -->
        <TextView
            android:id="@+id/messageTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="#4A4A4A"
            android:fontFamily="arial"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="normal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- счетчик времени до закрытия -->
        <LinearLayout
            android:id="@+id/messageCloseLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/messageTextView"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <!-- фиксированный текст -->
            <TextView
                android:id="@+id/messageCloseText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="закроется через "
                android:textColor="#000000"
                android:textSize="16sp"
                android:fontFamily="arial"
                android:textStyle="italic"
                android:alpha="0.8" />

            <!-- количество оставшихся секунд -->
            <TextView
                android:id="@+id/messageCloseSeconds"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#000000"
                android:textSize="16sp"
                android:fontFamily="arial"
                android:textStyle="italic"
                android:alpha="0.8"
                android:gravity="center" />

        </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>